{
  "compilerOptions": {
    "paths": {
      "$*": ["./src/*", "./src/*/"]
    },
    // module
    "target": "es2022", // vitest -> vite:esbuild -> warning: Unrecognized target environment "es2023"
    "module": "preserve",
    "moduleResolution": "bundler",
    // typecheck
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "jsx": "react-jsx",
    "noEmit": true
  }
}
